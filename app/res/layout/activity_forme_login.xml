package com.example.projetoweb;

import android.content.Intent;
import android.os.Bundle;
import android.widget.Button;
import android.widget.EditText;
import android.widget.TextView;
import android.widget.Toast;

import androidx.appcompat.app.AppCompatActivity;

import com.example.projetoweb.data.DBHelper;

public class FormeLogin extends AppCompatActivity {

    private EditText etEmail, etSenha;
    private Button btnEntrar;
    private TextView tvCadastroLink;
    private DBHelper db;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_forme_login);

        etEmail = findViewById(R.id.etEmail);
        etSenha = findViewById(R.id.etSenha);
        btnEntrar = findViewById(R.id.btnEntrar);
        tvCadastroLink = findViewById(R.id.tvCadastroLink);

        db = new DBHelper(this);

        // 👉 Botão ENTRAR (login)
        btnEntrar.setOnClickListener(v -> {
            String email = etEmail.getText().toString().trim();
            String senha = etSenha.getText().toString().trim();

            if (email.isEmpty() || senha.isEmpty()) {
                Toast.makeText(this, "Preencha todos os campos!", Toast.LENGTH_SHORT).show();
                return;
            }

            boolean loginValido = db.validarLogin(email, senha);

            if (loginValido) {
                Toast.makeText(this, "Login realizado com sucesso!", Toast.LENGTH_SHORT).show();

                // Passar email para MainActivity
                Intent intent = new Intent(FormeLogin.this, MainActivity.class);
                intent.putExtra("usuarioEmail", email); // PASSA EMAIL DO USUÁRIO LOGADO
                startActivity(intent);
                finish();
            } else {
                Toast.makeText(this, "Usuário não encontrado!", Toast.LENGTH_SHORT).show();
            }
        });

        tvCadastroLink.setOnClickListener(v -> {
            Intent i = new Intent(this, CadastroActivity.class);
            startActivity(i);
        });
    }
}
