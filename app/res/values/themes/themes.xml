<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <!-- Título -->

    <!-- Card de informações -->
    <TextView
        android:id="@+id/tvTituloPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Perfil do Usuário"
        android:textColor="#B71C1C"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/cardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/tvTituloPerfil"
        android:layout_marginTop="24dp"
        android:padding="24dp"
        android:background="#FFF0F0"
        android:elevation="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome"
            android:textSize="18sp"
            android:textColor="#B71C1C"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvIdade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idade"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTipoSanguineo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo Sanguíneo"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvTelefone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Telefone"
            android:textSize="16sp"
            android:textColor="#333333"/>
    </LinearLayout>

    <!-- BOTÃO VOLTAR AO MENU -->

    <Button
        android:id="@+id/btnExcluirConta"
        android:layout_width="374dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/btnEditarPerfil"
        android:layout_marginTop="305dp"
        android:backgroundTint="#B71C1C"
        android:text="Excluir Conta"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnEditarPerfil"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Editar informações"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="#E53935"
        android:textColor="#FFFFFF"
        android:layout_below="@id/cardInfo"
        android:layout_margin="20dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="345dp"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@+id/btnEditarPerfil"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="-320dp"
        android:background="#B71C1C"
        android:gravity="center"
        android:text="Voltar ao menu"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />


</RelativeLayout>

